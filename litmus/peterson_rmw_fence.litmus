X86 peterson_rmw_fence
{ x=0; y=0; f=0; flag0=0; flag1=0; turn=0; }
P0 | P1 ;
 MOV [flag0],$1          | MOV [flag1],$1          ;
 MOV [turn],$1           | MOV [turn],$0           ;
 MOV EDX,$0              | MOV EDX,$0              ;
 XCHG [f],EDX            | XCHG [f],EDX            ;
 MOV EAX,[flag1]         | MOV EAX,[flag0]         ;
 MOV EBX,[turn]          | MOV EBX,[turn]          ;
exists
((0:EAX=0 \/ 0:EBX=0) /\ (1:EAX=0 \/ 1:EBX=1))
