eiid0 [label="a: W[x]=1\lproc:P0 poi:0\lMOV [x],1", shape="box", color="blue"];
eiid1 [label="b: W[y]=2\lproc:P0 poi:1\lMOV [y],2", shape="box", color="blue"];
}
subgraph cluster_proc1 { rank=sink; label = "Thread 1"; color=magenta; shape=box;
eiid2 [label="c: W[y]=1\lproc:P1 poi:0\lMOV [y],1", shape="box", color="blue"];
eiid3 [label="d: W[x]=2\lproc:P1 poi:1\lMOV [x],2", shape="box", color="blue"];
}

